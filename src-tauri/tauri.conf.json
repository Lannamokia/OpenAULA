{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAULA",
  "version": "1.0.0",
  "identifier": "com.openaula.driver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenAULA",
        "width": 1280,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png"
    ]
  }
}
